# Terraform working data, never the provider dependency lock file.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
*.plan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
*.tfvars
*.tfvars.json
!*.tfvars.example
!**/.terraform.lock.hcl
!**/*.tftest.hcl

# Credentials, tool caches, and machine-specific settings.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
.azure/
.secrets/
secrets/
credentials.json
.tools/
.venv/
node_modules/
__pycache__/
.checkov/
.external_modules/
.vscode/
*.sarif
*.sarif.json
